# TerraOps Configuration
# Safe local defaults - no secrets required

# API Settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (SQLite default for zero-cost / zero-setup)
DATABASE_PATH=data/terraops.db

# AI Provider Selection ("auto", "nvidia", "ollama", "none")
LLM_PROVIDER=auto

# Local Ollama AI Settings (Optional local LLM/embedding inference)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3.5:4b
EMBEDDING_MODEL=nomic-embed-text

# NVIDIA NIM API Settings (Optional cloud inference alternative)
# Get a free key at https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# In-Memory Rate Limiting (Prevent quota exhaustion and spamming)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=15

# Frontend Environment
VITE_API_URL=http://localhost:8000

