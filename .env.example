# TerraOps Configuration
# Safe local defaults - no secrets required

# API Settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (SQLite default for zero-cost / zero-setup)
DATABASE_PATH=data/terraops.db

# Local Ollama AI Settings (Optional local LLM/embedding inference)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3.5:4b
EMBEDDING_MODEL=nomic-embed-text

# Frontend Environment
VITE_API_URL=http://localhost:8000
